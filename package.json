{
  "name": "synclife-temp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5000",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build && mv dist/index.dev.html dist/index.html",
    "preview": "mkdir -p node_modules && vite preview --host 0.0.0.0 --port 5000",
    "lint": "oxlint",
    "deploy:build": "pnpm install && pnpm run build",
    "deploy:local": "pnpm run build && rm -rf assets && cp -r dist/assets assets && echo '预览已同步到根目录'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "@tailwindcss/vite": "^4.3.2",
    "browser-image-compression": "^2.0.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
